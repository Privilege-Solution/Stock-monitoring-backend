# Copy this file to `.env` and fill in real keys. `.env` is gitignored.
#
#   cp .env.example .env
#   $EDITOR .env

# Postgres connection string — required. Used by db.js for the daily,
# peer_prices, news_feed, news_daily_summary and fetch_log tables. Supabase and
# Railway URLs both work as-is. Without this, server.js crashes at boot with
# "DATABASE_URL not set in environment".
#
# On Railway, point this at the database service:  ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Google Gemini API key — powers the Gemini-search pipeline
# (lib/fetchers/gemini-search.mjs uses gemini-2.5-flash with Google Search
# grounding enabled). The news cron runs 5 batches a day, all ICT:
#   08:00  morning    (+ gemini-morning-brief on Mondays)
#   12:30  midday
#   15:00  afternoon
#   17:30  evening    (+ gemini-daily-summary)
#   21:00  night
# Without this key the gemini-* sources are skipped and the batches run
# RSS-only; the /api/*/refresh routes that need Gemini return 400.
GEMINI_API_KEY=

# =============================================================================
# Access control — OPTIONAL, but the API is COMPLETELY OPEN without it.
#
# There is no built-in login. Anything that can reach the URL can call every
# mutating route, including `DELETE /api/news/:id` (which will happily delete
# any row) and `POST /api/news/refresh-all` (which burns Gemini quota). On a
# public Railway URL that means anyone on the internet. The server prints a
# loud warning at boot while both of these are unset.
#
# DASHBOARD_USER + DASHBOARD_PASS — HTTP Basic Auth over EVERYTHING, including
# the dashboard page itself. The browser prompts once and then sends the
# credentials automatically, so the frontend needs no changes. This is the
# recommended setting for an internal dashboard.
# DASHBOARD_USER=admin
# DASHBOARD_PASS=change-me

# API_TOKEN — accepted as the `X-API-Token` header, for curl / cron / uptime
# checks that can't do Basic Auth. If this is set but Basic is NOT, only
# mutating requests (POST/PUT/PATCH/DELETE) are gated — a browser cannot send a
# custom header for a normal page load, so gating GETs on the token alone would
# make the dashboard unreachable.
# API_TOKEN=

# GET /api/health is always exempt so Railway's healthcheck keeps passing.
# =============================================================================

# Optional overrides
#
# PORT — Railway injects this automatically; only set it for local runs.
# PORT=3000
#
# ALLOWED_ORIGIN — the API sends no CORS headers by default, which is correct
# because the dashboard is served from this same origin. Set this only if you
# host the frontend on a different domain.
# ALLOWED_ORIGIN=https://dashboard.example.com
#
# DATABASE_SSL — SSL is decided automatically: on for Supabase and the Railway
# proxy host, off for *.railway.internal and localhost. Override with
# `disable` (or `require`) only if that heuristic gets your host wrong.
# DATABASE_SSL=
#
# SKIP_SAMPLE_SEED=1 — don't seed the bundled sample_data.js rows when the DB
# is empty. Use after wiping the DB so the dashboard stays empty until a real
# backfill runs.
# SKIP_SAMPLE_SEED=1
